                <button class="button prod" type="submit">Logout</button>
            </form>
            <span class="nav-user">Hi, <%= user.username %></span>
        <% } else { %>
            <a class="button login" href="/login">Login</a>
            <a class="button reg" href="/register">Register</a>
        <% } %>
    </div>
</nav>